{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node.capability.grantedPayload",
  "description": "Payload schema for Pulse type node.capability.granted",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "node_id",
    "capability",
    "risk_tier",
    "expiry"
  ],
  "additionalProperties": false
}