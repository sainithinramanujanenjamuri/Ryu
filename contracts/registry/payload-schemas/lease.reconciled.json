  "type": "object",
  "properties": {
    "lease_token": {
      "type": "string"
    },
    "space_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["lease_token", "space_id", "task_id", "attempt_id", "released_at"],
  "additionalProperties": false
}
