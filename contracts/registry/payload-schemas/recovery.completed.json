{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recovery.completedPayload",
  "description": "Payload schema for Pulse type recovery.completed (ADR-0042, RECOVERY-006)",
  "type": "object",
  "properties": {
    "daemon_instance_id": {
      "type": "string"
    },
    "recovered_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "released_leases": {
      "type": "integer",
      "minimum": 0
    },
    "escalated_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "total_duration_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["daemon_instance_id", "recovered_tasks", "released_leases", "escalated_tasks", "total_duration_seconds"],
  "additionalProperties": false
}
